	(text "RISK::: When the eFuse is off, U12 has no power but still sits on \nPOWER_SDA/SCL. If its SDA/SCL pins clamp the bus while \nunpowered, the INA3221 becomes unreachable. Bench-test \nthis with the eFuse off."
		(exclude_from_sim no)
		(at 424.942 176.53 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left)
		)
