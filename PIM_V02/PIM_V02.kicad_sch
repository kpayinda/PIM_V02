	(text "BOOT0 selects DFU at reset\n"
		(exclude_from_sim no)
		(at 288.036 17.272 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "23bf5739-20c3-47ce-b81b-c8e2a7e36d44")
	)
	(text "LEARN HOW THIS FPGA WORKS, STARTUP SEQ AND THEN \nALSO WHAT THE RAILS NEED TO BE CONFIGURABLE.\n\ni2c needs pullups, and dont damage others"
		(exclude_from_sim no)
		(at 50.038 315.722 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left)
		)
		(uuid "24236f89-6264-492f-b64b-d68b9bbc5b69")
	)
	(text "picoblade"
		(exclude_from_sim no)
		(at 208.026 20.574 0)
		(effects
			(font
				(size 2.54 2.54)
			)
		)
		(uuid "25de01c0-5563-4332-8422-a6a395cef0bf")
	)
	(text "POWER UP SEQ:\nVCC/VCCPLL → SPI_VCCIO1 → \nVPP_2V5 → VCCIO_0/2, \neach reaching 0.5 V before the next"
		(exclude_from_sim no)
		(at 178.054 311.912 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left)
		)
		(uuid "33190c39-1a14-48f5-b94e-1f5ca3360e03")
	)
	(text "BOOT0 = LOW at reset → run your firmware (normal).\nBOOT0 = HIGH at reset → run ST's bootloader → chip shows up on the PC as a USB DFU device → we flash it."
		(exclude_from_sim no)
		(at 307.594 -5.08 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "34604d09-9f25-4aed-aef9-0f30969de81e")
	)
	(text "remove for flight\n\n1.27 mm pitch"
		(exclude_from_sim no)
		(at 373.761 215.646 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "4eddaa02-cf01-4d3f-8a63-31ff17dc4ae3")
	)
	(text "SPI_SS has an internal pull-up, and the FPGA samples it \nwhen CRESET_B is released - high would put it into master \nmode and it'd try to boot from a flash that isn't there. \nAfter exiting the Power-On Reset (POR) state or when \nCRESET_B returns High after being held Low, the iCE40 \ndevice samples the logical value on its SPI_SS_B pin \nPulling it low (plus the MCU driving it low) guarantees \nslave mode. it samples the SPI_SS to select the \nconfiguration mode (an output in Master mode and an \ninput in Slave mode)"
		(exclude_from_sim no)
		(at 426.212 70.866 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left)
		)
		(uuid "4fe736da-8797-4834-bca7-a75863a0ea0a")
	)
	(text "CRESET held low by pulldown, so FPGA only on when MCU drives it on."
		(exclude_from_sim no)
		(at 13.97 169.926 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "53833a57-2722-4977-a1f0-52c0bc20487b")
	)
	(text "USB-C\n"
		(exclude_from_sim no)
		(at 24.638 101.6 0)
		(effects
			(font
				(size 3.81 3.81)
			)
		)
		(uuid "6a2ebebc-62b4-4071-977a-2b9f6eadf987")
	)
	(text "Chassis on flight"
		(exclude_from_sim no)
		(at 379.73 232.41 0)
		(effects
