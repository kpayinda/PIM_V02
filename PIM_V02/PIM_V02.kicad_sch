	)
	(text "One datasheet item to confirm: \nwhether TPS259541DSGR is the \nlatch-off or auto-retry variant, \nand whether it exposes an IMON \n(analog current-monitor) pin - \nthe TPS2594 family generally does, \nand if this variant/package brings it \nout, you get input current sensing \nfor free. I'll verify this from the datasheet next."
		(exclude_from_sim no)
		(at 177.038 78.74 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left)
		)
		(uuid "a9ec4297-122f-4c89-8ec0-a2505639981b")
	)
	(text "picolock"
		(exclude_from_sim no)
		(at 26.924 48.768 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "adc4340f-899f-4d46-8323-3887cd897b8a")
	)
	(text "Firmware rule: only run the FPGA config sequence once the \n1V2_HK (and 3V3_HK) PG reads good. The 33 Ω series \nresistors on the SPI lines also limit any stray back-drive \nin the meantime."
		(exclude_from_sim no)
		(at 434.086 234.95 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left)
		)
		(uuid "b9dabe22-3901-4e50-80a0-14011a2e6fa1")
	)
